# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local images: kept out of git until licensing is confirmed. The GitHub
# repo is public, so committing them would publish them; the current hero
# image also shows another clinic's branding. Pages fall back to
# placeholders when files are missing.
# Exception: the provider portrait is CANA's own photo, approved for
# publication, so that ONE file is tracked. (Git can't re-include a file
# inside an ignored directory, hence the directory/* + ! pattern.)
/public/images/*
!/public/images/provider/
/public/images/provider/*
!/public/images/provider/portrait.jpg
