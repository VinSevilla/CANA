# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local images (service photos, hero, provider portrait): kept out of git
# until licensing is confirmed. The GitHub repo is public, so committing
# them would publish them; the current hero image also shows another
# clinic's branding. Pages fall back to placeholders when files are
# missing. Remove this entry once licensed images are ready to commit.
/public/images/
